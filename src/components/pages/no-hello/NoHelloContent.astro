---
import { type Locale, t } from '@/intl';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;

const p1Text = t(locale, 'no-hello.p1');
const [p1Before, p1After] = p1Text.split('{s}');

const footerText = t(locale, 'no-hello.footer');
const footerParts = footerText.split(/\{a\}|\{b\}/);
/*
