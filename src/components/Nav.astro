---
import { type Locale, t, switchLocalePath } from '@/intl';

interface Props {
    locale: Locale;
    currentPath: string;
}

const { locale, currentPath } = Astro.props;

const homeHref = locale === 'th' ? '/' : `/${locale}/`;
const aboutHref = locale === 'th' ? '/#about' : `/${locale}/#about`;
const contactHref = locale === 'th' ? '/#contact' : `/${locale}/#contact`;
---

<div class="mx-auto max-w-7xl px-4">
    <nav class="[&_a]:no-underline [&_a:hover]:underline">
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-background focus:text-foreground focus:border focus:border-border focus:rounded-md focus:p-2"
        >
            {t(locale, 'nav.skip_to_content')}
        </a>
        <div class="mt-4 grid grid-cols-1 md:grid-cols-3 gap-2 text-center items-center">
            <div class="md:text-left">
                <p class="text-lg font-semibold m-0">
                    <a href={homeHref} class="no-underline hover:underline text-foreground">
                        {t(locale, 'nav.title')}
                    </a>
                </p>
            </div>
            <div class="space-x-1">
                <a href={aboutHref}>{t(locale, 'nav.about')}</a>
                <span class="text-muted-foreground">|</span>
                <a href="https://tangmo-gal.anthro.asia">{t(locale, 'nav.gallery')}</a>
                <span class="text-muted-foreground">|</span>
                <a href={contactHref}>{t(locale, 'nav.contact')}</a>
            </div>
            <div class="md:text-right space-x-2">
                {
                    locale === 'th' ? (
                        <span lang="th" class="font-medium">
                            ภาษาไทย
                        </span>
                    ) : (
                        <a href={switchLocalePath(currentPath, locale, 'th')} lang="th">
                            ภาษาไทย
                        </a>
                    )
                }
                {
                    locale === 'en' ? (
                        <span lang="en" class="font-medium">
                            English
                        </span>
                    ) : (
                        <a href={switchLocalePath(currentPath, locale, 'en')} lang="en">
                            English
                        </a>
                    )
                }
                {
                    locale === 'uwu' ? (
                        <span lang="en" class="font-medium">
                            UwU
                        </span>
                    ) : (
                        <a href={switchLocalePath(currentPath, locale, 'uwu')} lang="en">
                            UwU
                        </a>
                    )
                }
            </div>
        </div>
        <hr class="my-4 border-border" />
    </nav>
</div>
