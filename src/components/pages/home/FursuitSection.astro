---
import { type Locale, t } from '@/intl';
import { Image } from 'astro:assets';
import fursuitImgSdr from '@/images/IMG_4697.jpg';
import fursuitWhiteImgSdr from '@/images/IMG_20241201_144830-3.jpg';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;

const madeByText = t(locale, 'index.aboutFursuit.madeBy');
const [madeBefore, madeAfter] = madeByText.split('{link}');

const whiteMadeByText1 = t(locale, 'index.aboutFursuit.whiteMadeBy1');
const [whiteMadeByText1Before, whiteMadeByText1After] = whiteMadeByText1.split('{link}');
const whiteMadeByText2 = t(locale, 'index.aboutFursuit.whiteMadeBy2');
const [whiteMadeByText2Before, whiteMadeByText2After] = whiteMadeByText2.split('{link}');

const photoCreditText = t(locale, 'common.photoCredits');
const [photoBefore, photoAfter] = photoCreditText.split('{link}');
---

<h2 class="text-2xl font-bold mb-3">
    {t(locale, 'index.aboutFursuit.title')}
</h2>
<section class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
        <figure class="m-0">
            <div class="aspect-square md:aspect-auto lg:aspect-square xl:aspect-[4/3] overflow-hidden rounded-lg">
                <!-- HDR version -->
                <a href="https://tangmo-gal.anthro.asia/picture/4211/category/10" class="hdr-only">
                    <img
                        src="/IMG_4697.avif"
                        alt={t(locale, 'index.aboutFursuit.imageAlt')}
                        class="w-full h-full object-cover object-top xl:object-[center_12%]"
                        loading="lazy"
                    />
                </a>
                <!-- HDR video fallback for Safari < 26 / Firefox macOS -->
                <a href="https://tangmo-gal.anthro.asia/picture/4211/category/10" class="hdr-video-fallback">
                    <video
                        src="/IMG_4697.mp4"
                        autoplay
                        muted
                        playsinline
                        class="w-full h-full object-cover object-top xl:object-[center_12%]"></video>
                </a>
                <!-- SDR fallback -->
                <a href="https://tangmo-gal.anthro.asia/picture/4210/category/7" class="sdr-only">
                    <Image
                        src={fursuitImgSdr}
                        alt={t(locale, 'index.aboutFursuit.imageAlt')}
                        widths={[400, 600, 800]}
                        sizes="(min-width: 768px) 50vw, 100vw"
                        format="avif"
                        quality="90"
                        class="w-full h-full object-cover object-top xl:object-[center_12%]"
                    />
                </a>
            </div>
            <figcaption class="text-sm text-muted-foreground mt-2">
                {photoBefore}<a href="https://twitter.com/Rig_sor2024" rel="noreferrer noopener">Rigel</a>{photoAfter}
            </figcaption>
            <p class="mt-2">
                {madeBefore}<a href="https://www.kigurumikagetsu.jp/en/%E8%A4%87%E8%A3%BD-stc" rel="noreferrer noopener"
                    >Kigurumi Kagetsu Co., Ltd.</a
                >{madeAfter}
            </p>
        </figure>
    </div>
    <div>
        <figure class="m-0">
            <div class="md:aspect-square lg:aspect-auto overflow-hidden rounded-lg">
                <!-- HDR version -->
                <a href="https://tangmo-gal.anthro.asia/picture/3747/category/10" class="hdr-only">
                    <img
                        src="/IMG_20241201_144830-3.avif"
                        alt={t(locale, 'index.aboutFursuit.imageWhiteAlt')}
                        class="w-full h-full object-cover object-top xl:object-[center_12%]"
                        loading="lazy"
                    />
                </a>
                <!-- HDR video fallback for Safari < 26 / Firefox macOS -->
                <a href="https://tangmo-gal.anthro.asia/picture/3747/category/10" class="hdr-video-fallback">
                    <video
                        src="/IMG_20241201_144830-3.mp4"
                        autoplay
                        muted
                        playsinline
                        class="w-full h-full object-cover object-top xl:object-[center_12%]"></video>
                </a>
                <!-- SDR fallback -->
                <a href="https://tangmo-gal.anthro.asia/picture/3191/category/7" class="sdr-only">
                    <Image
                        src={fursuitWhiteImgSdr}
                        alt={t(locale, 'index.aboutFursuit.imageWhiteAlt')}
                        widths={[400, 600, 800]}
                        sizes="(min-width: 768px) 50vw, 100vw"
                        format="avif"
                        quality="90"
                        class="w-full h-full object-cover md:object-[90%_center] lg:object-right"
                    />
                </a>
            </div>
            <figcaption class="text-sm text-muted-foreground mt-2">
                {photoBefore}<a href="https://twitter.com/Cookizi" rel="noreferrer noopener">Cookizi</a>{photoAfter}
            </figcaption>
        </figure>
        <p class="mt-2">
            {whiteMadeByText1Before}<a href="https://twitter.com/tropictora" rel="noreferrer noopener">Tropictora</a>{whiteMadeByText1After}
        </p>
        <p>{whiteMadeByText2Before}<a href="https://gentlefur.taobao.com" rel="noreferrer noopener">重庆仟鸟艺术发展有限公司</a>{whiteMadeByText2After}</p>
    </div>
</section>
