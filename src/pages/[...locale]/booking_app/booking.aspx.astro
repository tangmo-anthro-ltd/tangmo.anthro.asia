---
import Layout from '@/layouts/Layout.astro';
import BookingPage from '@/components/pages/booking/BookingPage.astro';
import { getLocaleStaticPaths, localeFromParams, t } from '@/intl';

export const getStaticPaths = getLocaleStaticPaths;
const locale = localeFromParams(Astro.params);
---

<Layout title={t(locale, 'bookingApp.booking.title')} locale={locale}>
    <BookingPage locale={locale} />
</Layout>
