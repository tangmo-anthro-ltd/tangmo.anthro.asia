---
import Layout from '@/layouts/Layout.astro';
import HomePageHead from '@/components/pages/home/HomePageHead.astro';
import IntroSection from '@/components/pages/home/IntroSection.astro';
import FursuitSection from '@/components/pages/home/FursuitSection.astro';
import { type Locale, t } from '@/intl';

const locale: Locale = 'en';
---

<Layout title={t(locale, 'index.title')} locale={locale}>
    <HomePageHead />
    <div class="mx-auto max-w-7xl px-4">
        <IntroSection locale={locale} />
        <hr class="my-8 border-border" />
        <FursuitSection locale={locale} />
    </div>
</Layout>
