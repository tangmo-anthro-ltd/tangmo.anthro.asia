---
import Bare from '@/layouts/Bare.astro';
import NoHelloContent from '@/components/pages/no-hello/NoHelloContent.astro';
import { getLocaleStaticPaths, localeFromParams, t } from '@/intl';

export const getStaticPaths = getLocaleStaticPaths;
const locale = localeFromParams(Astro.params);
---

<Bare
    title={t(locale, 'no-hello.meta_title')}
    description={t(locale, 'no-hello.meta_description')}
    extraMeta={[
        { name: 'og:image', content: 'https://nohello.club/social.png' },
        { name: 'twitter:title', content: t(locale, 'no-hello.meta_title') },
        { name: 'twitter:description', content: t(locale, 'no-hello.meta_description') },
    ]}
    locale={locale}
>
    <NoHelloContent locale={locale} />
</Bare>
