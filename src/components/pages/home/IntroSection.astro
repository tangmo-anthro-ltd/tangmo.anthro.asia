---
import { type Locale, t, localePath } from '@/intl';
import { Image } from 'astro:assets';
import charaImgSdr from '@/images/index-chara11.png';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;

const artCreditText = t(locale, 'common.artCredits');
const [creditBefore, creditAfter] = artCreditText.split('{link}');
---

<section id="about">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
        <div class="md:col-span-7 order-2 md:order-1">
            <h1 class="text-3xl font-bold mb-4">{t(locale, 'index.aboutMe.title')}</h1>
            <p class="mb-4 text-lg leading-relaxed">{t(locale, 'index.aboutMe.para')}</p>
            <a
                href={localePath(locale, '/character-reference')}
                class="inline-block px-4 py-2 border border-primary rounded-md text-foreground no-underline hover:bg-primary hover:text-primary-foreground transition-colors"
            >
                {t(locale, 'index.aboutMe.refSheet')}
            </a>
        </div>
        <div class="md:col-span-5 order-1 md:order-2">
            <figure class="m-0">
                <a href={localePath(locale, '/character-reference')}>
                    <!-- HDR version for HDR displays -->
                    <img
                        src="/index-chara11_hdr.avif"
                        alt={t(locale, 'index.aboutMe.charaImageAlt')}
                        class="w-full rounded-lg hdr-only"
                        loading="lazy"
                    />
                    <!-- HDR video fallback for Safari < 26 / Firefox macOS -->
                    <video
                        src="/index-chara11_hdr.mp4"
                        autoplay
                        muted
                        playsinline
                        class="w-full rounded-lg hdr-video-fallback"></video>
                    <!-- SDR fallback processed by Astro -->
                    <Image
                        src={charaImgSdr}
                        alt={t(locale, 'index.aboutMe.charaImageAlt')}
                        widths={[400, 600, 800]}
                        sizes="(min-width: 768px) 40vw, 100vw"
                        format="avif"
                        quality="high"
                        class="w-full rounded-lg sdr-only"
                    />
                </a>
                <figcaption class="text-end text-sm text-muted-foreground mt-2">
                    {creditBefore}<a href="https://twitter.com/lanhufengchen" rel="noreferrer noopener" lang="zh-CN"
                        >岚虎枫晨</a
                    >{creditAfter}
                    <span class="hdr-only">{t(locale, 'common.artHdrEditCredit')}</span>
                </figcaption>
            </figure>
        </div>
    </div>
</section>
