---
import Layout from '@/layouts/Layout.astro';
import ResultPage from '@/components/pages/booking/ResultPage.astro';
import { getLocaleStaticPaths, localeFromParams, t } from '@/intl';

export const getStaticPaths = getLocaleStaticPaths;
const locale = localeFromParams(Astro.params);
---

<Layout title={t(locale, 'bookingApp.result.title')} locale={locale}>
    <ResultPage locale={locale} />
</Layout>
