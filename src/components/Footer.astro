---
import { type Locale, t } from '@/intl';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const footerText = t(locale, 'footer.last_updated');
const buildTime = new Date().toISOString();
const [before, after] = footerText.split('{date}');
---

<footer class="mx-auto max-w-7xl px-4">
    <hr class="mt-8 border-border" />
    <div class="flex justify-between items-center py-4">
        <p class="text-sm text-muted-foreground m-0">
            {before}<time datetime={buildTime} data-local-time
                >{
                    new Date(buildTime).toLocaleString('en-ZA', {
                        year: 'numeric',
                        month: 'numeric',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit',
                        second: '2-digit',
                        timeZone: 'UTC',
                        timeZoneName: 'short',
                    })
                }</time
            >{after}
        </p>
        <p class="text-sm m-0">
            <a href="https://github.com/tangmo-anthro-ltd/tangmo.anthro.asia" rel="noreferrer noopener">
                {t(locale, 'footer.source')}
            </a>
        </p>
    </div>
</footer>

<script>
    document.querySelectorAll<HTMLElement>('time[data-local-time]').forEach(el => {
        const iso = el.getAttribute('datetime');
        if (iso) {
            el.textContent = new Date(iso).toLocaleString('en-ZA', {
                year: 'numeric',
                month: 'numeric',
                day: 'numeric',
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit',
                timeZoneName: 'short',
            });
        }
    });
</script>
