---
import Layout from '@/layouts/Layout.astro';
import CharRefHPage from '@/components/pages/character-reference/HPage.astro';
import { getLocaleStaticPaths, localeFromParams, t } from '@/intl';

export const getStaticPaths = getLocaleStaticPaths;
const locale = localeFromParams(Astro.params);
---

<Layout title={t(locale, 'reference-h.title')} extraMeta={[{ name: 'robots', content: 'noindex' }]} locale={locale}>
    <CharRefHPage locale={locale} />
</Layout>
