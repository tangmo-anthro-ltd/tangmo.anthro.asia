---

<div class="max-w-[860px] mx-auto p-4 font-[Trebuchet_MS,Lucida_Grande,sans-serif] text-[110%]">
    <header class="my-[60px] md:my-[150px_auto_75px]">
        <h1
            class="text-[40px] md:text-[94px] font-bold m-0 leading-tight font-[lato,ubuntu,-apple-system,BlinkMacSystemFont,sans-serif]"
        >
            {t(locale, 'no-hello.hero.no')}
            <span class="line-through decoration-red-500">{t(locale, 'no-hello.hero.hello')}</span>
        </h1>
        <span class="block text-2xl font-light mt-2">
            {t(locale, 'no-hello.meta_description')}
        </span>
    </header>

    <section id="intro">
        <p>
            {p1Before}<strong>{t(locale, 'no-hello.p1_strong')}</strong>{p1After}
        </p>

        <div class="chatbox">
            <p class="chat left animate-in" style="animation-delay: 1s">
                {t(locale, 'no-hello.chat.chat1_1')}
                <span class="timestamp">{t(locale, 'no-hello.chat.monday')} 17:30</span>
            </p>
            <p class="chat right animate-in" style="animation-delay: 2s">
                {t(locale, 'no-hello.chat.chat1_2')}
                <span class="timestamp">{t(locale, 'no-hello.chat.monday')} 17:35</span>
            </p>
            <p class="chat left animate-in" style="animation-delay: 3s">
                {t(locale, 'no-hello.chat.chat1_3')}
                <span class="timestamp">{t(locale, 'no-hello.chat.monday')} 17:40</span>
            </p>
            <p class="chat right animate-in" style="animation-delay: 4s">
                {t(locale, 'no-hello.chat.chat1_4')}
                <span class="timestamp">{t(locale, 'no-hello.chat.monday')} 17:51</span>
            </p>
            <p class="chat left animate-in" style="animation-delay: 5s">
                {t(locale, 'no-hello.chat.chat1_5')}
                <span class="timestamp">{t(locale, 'no-hello.chat.tuesday')} 09:30</span>
            </p>
            <p class="chat right animate-in" style="animation-delay: 6s">
                {t(locale, 'no-hello.chat.chat1_6')}
                <span class="timestamp">{t(locale, 'no-hello.chat.tuesday')} 17:08</span>
            </p>
            <p class="chat left animate-in" style="animation-delay: 7s">
                {t(locale, 'no-hello.chat.chat1_7')}
                <span class="timestamp">{t(locale, 'no-hello.chat.tuesday')} 17:18</span>
            </p>
            <p class="chat right animate-in" style="animation-delay: 8s">
                {t(locale, 'no-hello.chat.chat1_8')}
                <span class="timestamp">{t(locale, 'no-hello.chat.wednesday')} 16:41</span>
            </p>
            <p class="chat left animate-in" style="animation-delay: 9s">
                {t(locale, 'no-hello.chat.chat1_9')}
                <span class="timestamp">{t(locale, 'no-hello.chat.wednesday')} 16:54</span>
            </p>
        </div>

        <p>{t(locale, 'no-hello.p2')}</p>
        <p class="font-semibold">{t(locale, 'no-hello.p3')}</p>

        <div class="chatbox" id="chatbox2">
            <p class="chat left to-animate" style="animation-delay: 1s; white-space: pre-line">
                {t(locale, 'no-hello.chat.chat2_1')}
                <span class="timestamp">{t(locale, 'no-hello.chat.monday')} 17:30</span>
            </p>
            <p class="chat right to-animate" style="animation-delay: 2s; white-space: pre-line">
                {t(locale, 'no-hello.chat.chat2_2')}
                <span class="timestamp">{t(locale, 'no-hello.chat.monday')} 17:35</span>
            </p>
            <p class="chat left to-animate" style="animation-delay: 3s">
                {t(locale, 'no-hello.chat.chat2_3')}
                <span class="timestamp">{t(locale, 'no-hello.chat.monday')} 17:40</span>
            </p>
        </div>

        <p class="text-[120%] italic text-center whitespace-pre-line">
            {t(locale, 'no-hello.p4')}
        </p>
    </section>

    <footer class="text-center mt-8">
        <p>
            {footerParts[0]}<a href="https://nohello.club/" rel="noreferrer noopener">nohello.club</a>{footerParts[1]}<a
                href="https://nohello.net/"
                rel="noreferrer noopener">nohello.net</a
            >{footerParts[2] || ''}
        </p>
    </footer>
</div>

<script>
    // Progressive enhancement: IntersectionObserver for second chatbox animation
    const chatbox2 = document.getElementById('chatbox2');
    if (chatbox2) {
        const observer = new IntersectionObserver(
            entries => {
                entries.forEach(e => {
                    if (e.isIntersecting) {
                        chatbox2.querySelectorAll('.to-animate').forEach(el => el.classList.add('animate-in'));
                        observer.disconnect();
                    }
                });
            },
            { threshold: 0.5 }
        );
        // Delay observation so first chatbox can play first
        setTimeout(() => observer.observe(chatbox2), 10000);
    }
</script>

<style>
    /* Chat styles */
    .chatbox {
        padding: 1em;
        background-color: antiquewhite;
        border-radius: 1em;
        box-shadow: 0 0 10px inset #8883;
        max-width: 600px;
        margin: 1em auto;
    }
    .chat {
        padding: 0.5em 1em;
        border-radius: 0.5em;
        width: fit-content;
        max-width: 90%;
        box-shadow: 0.5em 0.5em 1em #8888;
        position: relative;
        margin: 1em;
        color: #111;
    }
    .chat::before {
        content: '';
        width: 0;
        height: 0;
        border: 0.5em solid transparent;
        position: absolute;
    }
    .chat.right {
        background-color: #baffd5;
        margin: 1em 1em 1em auto;
        text-align: right;
        transform-origin: 100% 100%;
    }
    .chat.right::before {
        right: -1em;
        bottom: 0.3em;
        border-left: 0.75em solid #baffd5;
    }
    .chat.left {
        background-color: #c9c9ff;
        margin: 1em auto 1em 1em;
        transform-origin: 0 0;
    }
    .chat.left::before {
        left: -1em;
        top: 0.3em;
        border-right: 0.75em solid #c9c9ff;
    }
    .chat .timestamp {
        display: block;
        font-size: 80%;
        font-family: monospace;
        color: darkslategrey;
        margin-top: 6px;
    }

    /* Animations */
    @keyframes pop-in {
        0% {
            transform: scale(0);
        }
        100% {
            transform: scale(1);
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .animate-in {
            transform: scale(0);
            animation: 250ms cubic-bezier(0, 0, 0.25, 1.25) 0s 1 normal forwards running pop-in;
        }
        .to-animate {
            transform: scale(0);
        }
    }

    /* Dark mode for this standalone page */
    @media (prefers-color-scheme: dark) {
        body {
            background-color: #272a2d;
            color: #eee;
        }
        a,
        a:visited,
        a:active {
            color: #fee;
        }
    }
</style>
