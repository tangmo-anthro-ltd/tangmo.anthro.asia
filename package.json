{
    "name": "tangmo-anthro-asia",
    "private": true,
    "description": "Source code for tangmo.anthro.asia.",
    "version": "0.1.0",
    "license": "UNLICENSED",
    "scripts": {
        "build": "npm run clean && node ./owo-gen.js && gatsby build",
        "develop": "npm run clean && gatsby develop --host=0.0.0.0",
        "format": "prettier --write \"**/*.{js,jsx,json,ts,tsx,md}\"",
        "serve": "gatsby serve",
        "clean": "gatsby clean",
        "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\" && exit 1"
    },
    "dependencies": {
        "babel-plugin-styled-components": "^2.1.4",
        "bootstrap": "^5.3.8",
        "bootstrap-icons": "^1.11.3",
        "gatsby": "^5.16.1",
        "gatsby-plugin-image": "^3.16.0",
        "gatsby-plugin-manifest": "^5.16.0",
        "gatsby-plugin-react-helmet": "^6.16.0",
        "gatsby-plugin-react-intl": "^4.0.0",
        "gatsby-plugin-react-svg": "^3.3.0",
        "gatsby-plugin-remove-trailing-slashes": "^4.19.0",
        "gatsby-plugin-sharp": "^5.16.0",
        "gatsby-plugin-styled-components": "^6.16.0",
        "gatsby-plugin-typescript": "^5.16.0",
        "gatsby-source-filesystem": "^5.16.0",
        "gatsby-transformer-sharp": "^5.16.0",
        "react": "^18.3.1",
        "react-bootstrap": "^2.10.8",
        "react-dom": "^18.3.1",
        "react-helmet": "^6.1.0",
        "styled-components": "^6.4.1",
        "stylis": "^4.4.0",
        "typescript": "^5.7.3"
    },
    "devDependencies": {
        "@types/node": "^24.1.0",
        "@types/react": "^18.3.23",
        "@types/react-dom": "^18.3.7",
        "@zuzak/owo": "^1.18.0",
        "prettier": "^3.8.3",
        "prettier-plugin-organize-imports": "^4.3.0"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/tangmo-anthro-ltd/tangmo.anthro.asia"
    },
    "prettier": {
        "arrowParens": "avoid",
        "singleQuote": true,
        "trailingComma": "es5",
        "plugins": [
            "prettier-plugin-organize-imports"
        ]
    }
}
